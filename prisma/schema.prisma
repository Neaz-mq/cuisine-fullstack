// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Persisted marketing preference for logged-in customers — lets us
  // prefill the checkout consent checkbox on their next order, and is
  // what the /admin/marketing "audience size" count is based on.
  // NOT the source of truth for guest checkout consent — see
  // Order.marketingConsent below for that.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime? // when they last changed it — useful for
  // proving consent timing if ever disputed

  // Running balance, kept in sync with LoyaltyTransaction rows inside the
  // same DB transaction whenever it changes (order delivered, manual admin
  // adjustment). Denormalized on purpose — displaying points for a user list
  // shouldn't require summing the whole ledger on every page view.
  loyaltyPoints Int @default(0)

  orders              Order[]
  reservations        Reservation[]
  reviews             Review[]
  loyaltyTransactions LoyaltyTransaction[]

  // Present only for staff accounts (role != CUSTOMER). A CUSTOMER user
  // never has one of these — the Staff management feature is what creates
  // both the User row and this row together, in one transaction.
  staffProfile StaffProfile?

  // Present only for Role.DELIVERY staff — every order this person has
  // ever been assigned to ride out. A rider "logs in" with the exact same
  // credentials login every other staff role uses; there is no separate
  // rider auth system.
  deliveries DeliveryTracking[] @relation("RiderDeliveries")

  // Staff member who recorded a given inventory change (manual purchase
  // entry, wastage, physical-count adjustment). Null on the StockMovement
  // side for automatic ORDER_DEDUCTION rows — see StockMovement.createdBy.
  stockMovementsRecorded StockMovement[]

  // Phase 2 — every PurchaseOrder this person has created, regardless of
  // its current status (DRAFT/ORDERED/RECEIVED/CANCELLED).
  purchaseOrdersCreated PurchaseOrder[]
}

// CUSTOMER is the only non-staff role. Every other value is a "staff role"
// (see lib/permissions.ts:isStaffRole) and gets a StaffProfile row.
//
// Renamed from the old two-value { CUSTOMER, ADMIN } enum: ADMIN -> OWNER
// (full, unrestricted access — same as ADMIN used to mean), plus five new
// narrower staff roles so day-to-day staff (waiters, kitchen, etc.) don't
// need full admin access just to do their job.
enum Role {
  CUSTOMER
  OWNER
  MANAGER
  WAITER
  CASHIER
  DELIVERY
  KITCHEN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

// One row per staff User (role != CUSTOMER), created together with the User
// row when an OWNER/MANAGER adds a new staff member via /admin/staff.
model StaffProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Human-facing sequential ID shown in the Staff UI (e.g. "EMP-0007") —
  // friendlier to read/say out loud than the cuid in `userId`.
  employeeId     String         @unique
  department     String?
  employmentType EmploymentType @default(FULL_TIME)
  phone          String?
  hireDate       DateTime       @default(now())

  // Deactivating a staff member (instead of deleting) keeps their name on
  // historical orders/audit trails intact, while blocking further login.
  // Re-checked against the DB on every admin request (see
  // lib/require-admin.ts) rather than trusted from the session JWT, since
  // a JWT issued before deactivation would otherwise stay valid.
  isActive Boolean @default(true)

  // ⚠️ SENSITIVE — only ever read or written by OWNER-role requests
  // (see canViewSensitiveStaffFields in lib/permissions.ts). MANAGER can
  // see/edit everything else on this model but not these two.
  //
  // KNOWN LIMITATION: Prisma has no field-level access control, so this
  // rule lives entirely in application code. A single forgotten `select`
  // — or an `include: { staffProfile: true }` on a user lookup — leaks
  // both. Moving these two into their own StaffSensitive model would
  // make leaking them require a deliberate second include rather than a
  // forgotten omission. Tracked, not yet done.
  nid    String?
  salary Decimal? @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  menuItems MenuItem[]

  // Coupons restricted to "only this category" — see the restriction note
  // on Coupon below. Most categories will have zero linked coupons; this
  // is not the common case, just an available rule.
  restrictedByCoupons Coupon[] @relation("CouponCategories")
}

model MenuItem {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Decimal  @db.Decimal(12, 3)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  category   Category    @relation(fields: [categoryId], references: [id])
  categoryId String
  orderItems OrderItem[]
  reviews    Review[]

  // Coupons restricted to "only this item" — see the restriction note on
  // Coupon below.
  restrictedByCoupons Coupon[] @relation("CouponItems")

  // The recipe / Bill-of-Materials for this item — see MenuItemIngredient
  // below. Empty (the default) means no inventory deduction happens when
  // this item is ordered, which keeps every existing menu item working
  // unchanged until a recipe is deliberately configured for it.
  ingredients MenuItemIngredient[]

  // The /menu page and the homepage category sections both do
  // `WHERE categoryId = ? AND isAvailable = true`. Postgres does NOT
  // auto-index foreign keys (unlike MySQL), and Prisma doesn't add one
  // either — without this, every category browse is a sequential scan.
  @@index([categoryId])
}

model Order {
  id     String      @id @default(cuid())
  status OrderStatus @default(PLACED)

  // ---------------------------------------------------------------------
  // Money — the full bill breakdown.
  //
  // Every line below is a SNAPSHOT taken at checkout, never recomputed on
  // read. That is the whole point: an owner may change the VAT rate, the
  // service charge, or even the currency next month, and last month's
  // invoice must still reprint exactly as the customer received it. Same
  // reasoning as the append-only ledgers elsewhere in this schema — the
  // stored row is the record of what happened, not a cache of what the
  // current settings would produce.
  //
  // The canonical order of operations lives in ONE place, lib/pricing.ts,
  // and is reproduced here only so the columns read in the right order:
  //
  //     subtotal
  //   − discountAmount        (coupon)
  //   − tierDiscountAmount    (loyalty tier)
  //   + serviceCharge         (% of the discounted subtotal)
  //   + deliveryFee
  //   + taxAmount             (EXCLUSIVE mode only — see taxMode)
  //   = grandTotal            ← the bill, before anything prepaid
  //   − giftCardAmount
  //   − pointsRedeemedAmount
  //   + tipAmount             ← deliberately AFTER the prepaid deductions
  //   = totalAmount           ← what is actually charged / collected
  // ---------------------------------------------------------------------

  // Sum of every OrderItem line (price × quantity) at the prices that
  // applied when the order was placed.
  subtotal Decimal @default(0) @db.Decimal(12, 3)

  // Percentage-based service charge, common in South/Southeast Asia and
  // the Middle East and near-universal in UK restaurants (where it
  // substitutes for tipping). 0 in most of Europe and the US.
  serviceCharge Decimal @default(0) @db.Decimal(12, 3)

  // Charged on DELIVERY orders only. Whether it is itself taxable varies
  // by jurisdiction — RestaurantSettings.deliveryFeeTaxable decides, and
  // the decision is baked into taxAmount below at checkout time.
  deliveryFee Decimal @default(0) @db.Decimal(12, 3)

  // The tax collected on this order, whatever it is locally called.
  //
  // In EXCLUSIVE mode this was ADDED on top of the prices the customer
  // browsed. In INCLUSIVE mode it was already inside them — the column
  // then records how much of grandTotal is tax, and grandTotal is NOT
  // increased by it. Reading taxAmount without reading taxMode is
  // therefore meaningless; both are snapshotted together below.
  taxAmount Decimal @default(0) @db.Decimal(12, 3)

  // Voluntary gratuity. Held apart from every other line for two reasons:
  // it is never part of the tax base in any jurisdiction, and in most it
  // is legally the staff's money rather than the restaurant's revenue —
  // so any revenue report must be able to subtract it cleanly. It is also
  // added AFTER giftCardAmount/pointsRedeemedAmount, so a prepaid
  // instrument can never quietly pay someone's tip on their behalf.
  tipAmount Decimal @default(0) @db.Decimal(12, 3)

  // The bill as printed, before gift card / points / tip. This is the
  // number a customer disputes, and the number tax reporting works from.
  grandTotal Decimal @default(0) @db.Decimal(12, 3)

  // What is actually charged to the card (or collected in cash for COD):
  // grandTotal, minus everything prepaid, plus the tip.
  totalAmount Decimal @db.Decimal(12, 3)

  // --- Snapshotted tax configuration -----------------------------------
  //
  // ISO 4217. Stored per order because a restaurant that changes currency
  // (or a future multi-branch deployment) must not retroactively relabel
  // historical invoices. lib/money.ts maps this to the minor-unit
  // exponent Stripe expects — 0 for JPY/KRW, 2 for most, 3 for KWD/BHD.
  currency String @default("BDT")

  // What the tax line was called on this invoice: "VAT", "GST",
  // "Sales Tax", "Consumption Tax", "IVA". Snapshotted so a rebrand in
  // settings doesn't rewrite history.
  taxName String @default("VAT")

  // The rate applied, as a FRACTION, not a percent: 0.05000 = 5%.
  // 5 decimal places because US sales-tax rates genuinely go to three
  // decimal places as a percentage (8.875% = 0.08875).
  taxRate Decimal @default(0) @db.Decimal(8, 5)

  taxMode TaxMode @default(EXCLUSIVE)

  // DELIVERY (default) = existing checkout flow, unchanged. DINE_IN = QR
  // Table Ordering — customer scans a QR code at a physical table, orders
  // are tied to `table` below instead of a delivery address, and are paid
  // for at the table (see paymentMethod note below), not delivered.
  orderType OrderType @default(DELIVERY)

  // Billing / contact details captured at checkout.
  //
  // firstName/lastName/phone stay REQUIRED for both order types — staff
  // still need a name to call out at the table for DINE_IN orders.
  //
  // email/country/address/city/state/zip are OPTIONAL as of QR Table
  // Ordering: a DINE_IN order has no delivery destination, so these are
  // simply never collected/set for orderType = DINE_IN. They remain
  // required in practice (application-layer validation) for
  // orderType = DELIVERY — this is intentionally not enforced at the DB
  // level, since Prisma can't express "required if X" directly. (A raw
  // Postgres CHECK constraint added via migration COULD express it —
  // a reasonable future hardening step, not done yet.)
  email     String?
  firstName String
  lastName  String
  phone     String
  country   String?
  address   String?
  apartment String?
  city      String?
  state     String?
  zip       String?

  // OPTIONAL as of QR Table Ordering — irrelevant for orderType = DINE_IN
  // (nothing is being shipped). Still required in practice for DELIVERY
  // orders, enforced at the application layer.
  shippingMethod ShippingMethod?

  // For orderType = DINE_IN, this is always COD — reused deliberately
  // rather than adding a third enum value, since "pay at table" is
  // functionally identical to "pay on delivery" (staff collects payment
  // in person, no online charge). The UI labels it "Pay at Table" instead
  // of "Cash on Delivery" for DINE_IN orders, but the stored value is COD.
  paymentMethod PaymentMethod

  // Which physical table a DINE_IN order belongs to. Null for DELIVERY
  // orders. Deliberately NOT required even when orderType = DINE_IN at the
  // DB level, for the same "can't express conditional-required in Prisma"
  // reason as the billing fields above — enforced at the application layer.
  table   RestaurantTable? @relation(fields: [tableId], references: [id])
  tableId String?

  // Discount/Coupon — totalAmount above is already net of this discount
  // (i.e. it's the actual amount charged/owed). discountAmount and
  // couponCode are denormalized here purely for display (order summary,
  // confirmation email, admin order detail) without needing a join back to
  // Coupon. The authoritative "was this coupon redeemed, on which order, by
  // which customer" record lives on CouponRedemption below (see the
  // Coupon/CouponRedemption models for the full v2 design rationale).
  //
  // These two fields are ALSO what makes cancellation reversal possible
  // without re-deriving anything — see lib/cancel-order.ts, which reads
  // couponCode here to release the redemption.
  couponCode       String?
  discountAmount   Decimal           @default(0) @db.Decimal(12, 3)
  couponRedemption CouponRedemption? // back-relation only — FK lives on CouponRedemption.orderId

  // Gift card redemption — same denormalized-display pattern as the
  // coupon fields above. giftCardAmount is already netted out of
  // totalAmount (the amount actually charged/owed). The authoritative
  // "which card, how much, on which order" record lives on
  // GiftCardTransaction below (type REDEEM) — giftCardCode/giftCardAmount
  // here exist purely so the order summary, confirmation email, and admin
  // order detail can show "Gift card XXXX applied — $12.00" without a
  // join back to GiftCard. A single order can only ever redeem ONE gift
  // card (matches the checkout UI, one code field at a time), same
  // simplification as couponCode being a single nullable field.
  //
  // As with couponCode above, these are also what lib/cancel-order.ts
  // reads to refund a redemption when an order is cancelled.
  giftCardCode         String?
  giftCardAmount       Decimal               @default(0) @db.Decimal(12, 3)
  giftCardTransactions GiftCardTransaction[]

  // Automatic loyalty-tier discount (Silver/Gold/Platinum get a % off,
  // see lib/loyalty-tiers.ts calcTierDiscountAmount) — already netted out
  // of totalAmount, same denormalized-display pattern as discountAmount/
  // giftCardAmount above. Unlike a coupon or gift card, there's no
  // separate claimed resource to release on cancellation (it's not a
  // code, not a balance — just a price rule evaluated at checkout), so
  // lib/cancel-order.ts has nothing to reverse for this one.
  tierDiscountAmount Decimal @default(0) @db.Decimal(12, 3)

  // Loyalty points redeemed by the customer at checkout for a dollar-for-
  // dollar-equivalent discount (see lib/loyalty-redemption.ts). Debited
  // from User.loyaltyPoints atomically at order-creation time — same
  // "claim now, refund on cancel" pattern as giftCardAmount above.
  // pointsRedeemedAmount is already netted out of totalAmount.
  pointsRedeemed       Int   @default(0)
  pointsRedeemedAmount Decimal @default(0) @db.Decimal(12, 3)

  // Guards against re-crediting loyalty points if an order is moved to
  // DELIVERED, reverted, and marked DELIVERED again by mistake. Claimed
  // atomically via updateMany (see lib/mark-order-delivered.ts) rather
  // than read-then-written, since two call sites can mark the same order
  // delivered concurrently — the admin status dropdown and the rider's
  // own /admin/my-deliveries action.
  pointsAwarded Boolean @default(false)

  // When this order's recipe ingredients were deducted from inventory, or
  // null if that hasn't happened yet. Set exactly once, on the
  // PLACED -> PREPARING transition (see lib/advance-order-to-preparing.ts).
  //
  // This column exists to be an atomic claim target: the deduction path
  // does `updateMany WHERE id = ? AND stockDeductedAt IS NULL` and only
  // proceeds when the affected-row count is 1, so two concurrent requests
  // can never both deduct. Reading StockMovement to check "did this
  // already happen" was the previous approach and is NOT safe — under
  // Postgres' default READ COMMITTED isolation neither transaction sees
  // the other's uncommitted rows, so both would deduct.
  //
  // A partial unique index on StockMovement couldn't serve this purpose
  // either, since deduction writes ONE ledger row PER INGREDIENT — a
  // three-ingredient dish legitimately produces three ORDER_DEDUCTION
  // rows for the same orderId.
  //
  // Reset to null by lib/cancel-order.ts is deliberately NOT done — the
  // RETURN movements are the reversal record, and leaving this set
  // prevents a cancelled-then-reinstated order from double-deducting.
  stockDeductedAt DateTime?

  // Tracks real payment confirmation for ONLINE orders via Stripe Checkout
  // + webhook — separate from `status` (fulfillment stage) because an order
  // can be PLACED in our DB before Stripe has actually confirmed the charge.
  // For COD orders (and DINE_IN, which is always COD) this is left at its
  // default and isn't currently acted on anywhere (no "mark paid on
  // delivery/at table" admin action exists yet).
  paymentStatus PaymentStatus @default(PENDING)

  // Captured at checkout, independent of User.marketingConsent, because
  // guest checkout (userId = null) has no User row to store a preference
  // on. This is what the checkout.session.completed webhook (and the COD
  // order-creation path) checks before calling syncCustomerToAudience().
  marketingConsent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Guest checkout is allowed, matching /carts which isn't behind auth
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  items               OrderItem[]
  loyaltyTransactions LoyaltyTransaction[]

  // One-to-one — only present once a rider has been assigned (see
  // POST /api/admin/orders/[id]/assign-rider). Null for DINE_IN orders and
  // for DELIVERY orders still using UBER_EATS/FOOD_PANDA.
  deliveryTracking DeliveryTracking?

  // Rider <-> customer live chat, active only while OUT_FOR_DELIVERY (see
  // ChatMessage below for the full design note).
  chatMessages ChatMessage[]

  // Inventory deductions (and any RETURN reversals) tied to this order —
  // see StockMovement below. Empty for orders made entirely of menu items
  // with no configured recipe.
  stockMovements StockMovement[]

  // tableId: DINE_IN orders looked up by table (unchanged, pre-existing).
  //
  // userId + createdAt: GET /api/orders/mine does `WHERE userId = ?
  // ORDER BY createdAt DESC` — every logged-in customer's order-history
  // page hits this exact pattern. Without it, that's a full table scan
  // once Order grows past a few hundred rows.
  //
  // status: the Kitchen board (GET /api/admin/kitchen/orders) polls this
  // table every 15s (see ETA_POLL_INTERVAL_MS) filtering `status IN
  // (PLACED, PREPARING)` — the single hottest read in the app. Also used
  // by the admin Orders list's status filter.
  //
  // createdAt (alone): the admin Orders list's default view — no status
  // filter, sorted newest-first — needs its own index since the
  // [userId, createdAt] composite above can't serve a query with no
  // userId predicate.
  @@index([tableId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

enum OrderType {
  DELIVERY
  DINE_IN
}

// Legal transitions between these values are defined in ONE place:
// lib/order-state-machine.ts. Every route that changes Order.status goes
// through it, so a PLACED order can't skip PREPARING and silently miss
// its inventory deduction (which is what assign-rider used to do).
//
// DELIVERED and CANCELLED are terminal. Reverting out of them is not
// supported, because loyalty points, stock deduction, and gift card
// debits have already happened by then and don't un-happen just because
// a status is changed back.
enum OrderStatus {
  PLACED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  UBER_EATS
  FOOD_PANDA
  // Restaurant's own delivery staff (Role.DELIVERY) — the rider is a real
  // staff account, assigned to the order from /admin/orders/[id], and
  // shares their live GPS position via the DeliveryTracking row below so
  // the customer's /track/[orderId] page can show a live map, the same
  // customer-facing pattern as Uber Eats / Food Panda's own apps.
  OWN_DELIVERY
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// Live rider tracking for OWN_DELIVERY orders. One row per order, created
// the moment an admin assigns a rider (POST
// /api/admin/orders/[id]/assign-rider) and never re-created after that —
// only ever updated (rider's phone posts new lat/lng every few seconds
// while /admin/my-deliveries is open, see POST
// /api/rider/deliveries/[orderId]/location).
//
// destLat/destLng are geocoded once at assignment time from the order's
// existing address fields (see lib/geocode.ts) — re-geocoding on every
// customer poll would be wasteful and Nominatim's free tier is rate
// limited.
//
// riderLat/riderLng start at the RESTAURANT's coordinates (see
// lib/restaurant-location.ts), not the destination — a delivery always
// begins at the restaurant, and seeding them with the customer's own
// address would render the rider marker sitting on the customer's
// doorstep before the rider has even set off. Reassignment resets them
// to the restaurant again for the same reason.
model DeliveryTracking {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  riderId String
  rider   User   @relation("RiderDeliveries", fields: [riderId], references: [id])

  riderLat Float
  riderLng Float
  // When riderLat/riderLng were last updated — the customer-facing map
  // uses this to show "updated Xs ago" and to detect a rider who has gone
  // quiet (tab closed / phone locked, since this is browser-based tracking
  // rather than a native background-GPS app).
  riderLocationUpdatedAt DateTime @default(now())

  destLat Float
  destLng Float

  assignedAt  DateTime  @default(now())
  deliveredAt DateTime?

  @@index([riderId])
}

// Rider <-> customer live chat for an OWN_DELIVERY order, same
// customer-facing idea as Uber Eats/Food Panda's in-app chat once a rider
// is on the way.
//
// No FK to User for the customer side — guest checkout (the common case
// for delivery orders, see Order.userId) has no User row to point at, so
// senderName is stored as plain text (order.firstName at send time)
// instead. The rider side doesn't need a User FK either: DeliveryTracking
// already records which rider owns this order, so senderRole = RIDER is
// enough to know who sent it without a second join.
//
// Trust model matches GET /api/orders/[id] (the /track/[orderId] page):
// possession of the unguessable order id is the access token. There's no
// separate customer login, so anyone with the tracking link can read/post
// chat for that order — acceptable because that's already true of the
// live map and order details on the same page.
//
// ⚠️ SECURITY — READ BEFORE DEPLOYING TO PRODUCTION
// Delivery uses Supabase Realtime (see lib/supabase-client.ts) rather
// than the 15s polling used elsewhere, because chat feels laggy at 15s.
// Making that work required TWO manual steps that Prisma migrations
// don't cover:
//   1. adding this table to the `supabase_realtime` publication
//      (done by hand in the Supabase dashboard — NOT in any migration,
//      so a fresh project silently has no working chat), and
//   2. migration 20260803120000_grant_chatmessage_select, which runs
//      `grant select on "ChatMessage" to anon, authenticated`.
//
// Step 2 is dangerous on its own. Prisma does not enable Row Level
// Security on the tables it creates, and `anon` is the role behind the
// publishable key that ships in the browser bundle. With RLS off, that
// grant makes EVERY chat message publicly readable — including the
// orderId in each row, which is the access token for /track/[orderId]
// and therefore for every customer's name, phone, and address.
//
// Before production: either enable RLS with a policy scoped to the
// order, or drop Realtime for chat and use SSE/polling through the
// existing API (which already checks the orderId).
model ChatMessage {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  senderRole ChatSenderRole
  // Denormalized display name at send time (rider's staff name, or the
  // customer's order.firstName) — avoids a join back to User/Order just to
  // render "Kalam: on my way" in the chat log, and survives a reassignment
  // (an old message still shows who actually sent it).
  senderName String

  message String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // GET /api/orders/[id]/chat and GET /api/rider/deliveries/[orderId]/chat
  // both do `WHERE orderId = ? ORDER BY createdAt ASC` for the initial
  // history load (Realtime handles everything after that).
  @@index([orderId, createdAt])
}

enum ChatSenderRole {
  RIDER
  CUSTOMER
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int

  // Price snapshot at order time — deliberately copied rather than read
  // from menuItem.price, so changing a menu price never rewrites the
  // totals on historical orders.
  //
  // NOTE: the item's TITLE is not snapshotted, so renaming a MenuItem
  // does retroactively change what past receipts and confirmation emails
  // display. Adding a `titleSnapshot` column here would close that gap.
  price Decimal @db.Decimal(12, 3)

  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String

  // orderId: the hottest join in the app — every order detail view, every
  // confirmation email, the kitchen board, and the admin orders list all
  // do `WHERE orderId = ?`. Postgres does not auto-index foreign keys and
  // Prisma doesn't add one, so without this every one of those is a
  // sequential scan over the whole OrderItem table.
  //
  // menuItemId: reverse lookup for "how many times has this dish been
  // ordered" (insights) and for the recommendations query.
  @@index([orderId])
  @@index([menuItemId])
}

// ---------------------------------------------------------------------------
// Discount coupons — v2, market-standard rule engine
//
// Supersedes the v1 "percentage-off, single global use" design. A coupon
// now carries a full set of independently-optional eligibility rules —
// discount type (percent or fixed), an expiry window, a minimum order
// value, a cap on how much a percent coupon can discount, a total
// redemption cap, and a per-customer redemption cap. Every rule is
// optional (null = "no restriction on this axis") so a simple "10% off,
// forever, unlimited" coupon is still just as easy to create as before.
//
// usageCount is a denormalized, atomically-incremented counter (see
// consumeCoupon in order-checkout-shared.ts) — it's the fast/cheap check
// for "has the global cap been hit" without a COUNT(*) over
// CouponRedemption on every checkout. CouponRedemption itself is the
// authoritative, queryable audit log: one row per successful redemption,
// carrying which order, which customer, and exactly how much discount was
// granted — needed both for per-customer limit enforcement and for
// usage analytics (a hard-deleted Coupon row would otherwise take that
// history down with it).
//
// isActive is independent of the usage counters — it's a manual
// admin kill-switch (pull a code immediately, e.g. a typo or abuse),
// separate from the coupon naturally running out via usageLimit or
// expiresAt.
// ---------------------------------------------------------------------------
model Coupon {
  id   String             @id @default(cuid())
  code String             @unique
  type CouponDiscountType @default(PERCENT)

  // Exactly one of these is meaningful, matching `type` — enforced at the
  // application layer (see validateCouponInput in order-checkout-shared.ts),
  // not at the DB level, since Prisma can't express a conditional-required
  // column directly.
  percentOff Int? // 1-100, required when type = PERCENT
  fixedOff   Decimal? @db.Decimal(12, 3) // currency amount, required when type = FIXED

  // Optional cap on the computed discount amount — mainly guards PERCENT
  // coupons from granting an unexpectedly large discount on a big order
  // (e.g. "20% off, capped at $15"). Ignored for FIXED coupons, since a
  // fixed amount is already its own cap.
  maxDiscountAmount Decimal? @db.Decimal(12, 3)

  // Optional minimum subtotal required to redeem (e.g. "min order $20").
  minOrderValue Decimal? @db.Decimal(12, 3)

  // Optional redemption window. Both null = no time restriction. A coupon
  // with only startsAt set isn't redeemable before that instant; only
  // expiresAt set isn't redeemable after it.
  startsAt  DateTime?
  expiresAt DateTime?

  // Optional global usage cap across ALL customers combined (e.g. "first
  // 100 redemptions"). Null = unlimited. usageCount is the atomically
  // incremented counter checked against this cap at redemption time.
  //
  // Decremented again by lib/cancel-order.ts when an order that consumed
  // a redemption is cancelled, so a cancelled order doesn't permanently
  // burn a slot on a limited campaign.
  usageLimit Int?
  usageCount Int  @default(0)

  // Optional per-customer cap (e.g. "one use per customer"). Null =
  // unlimited per customer. Defaults to 1, matching the most common
  // real-world "one redemption per person" coupon. Enforced by counting
  // that customer's CouponRedemption rows for this coupon — see
  // consumeCoupon's inline comment for the concurrency caveat on this
  // specific check.
  perCustomerLimit Int? @default(1)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  // Optional item/category scoping — both empty (the default) means "no
  // restriction, applies to the whole cart," matching every coupon's
  // behavior before this field existed (TEST10, SAVE5, etc. keep working
  // unchanged). When either is non-empty, the coupon is only redeemable
  // if the cart contains at least one matching line, and the discount is
  // computed against ONLY the matching lines' subtotal — not the whole
  // cart — see calcDiscountAmount/findValidCoupon in
  // order-checkout-shared.ts. minOrderValue above still checks the FULL
  // cart subtotal regardless of this scoping (a deliberate choice: "spend
  // $15 total, get $5 off the pizzas in that order" rather than "spend
  // $15 on pizzas specifically").
  restrictedCategories Category[] @relation("CouponCategories")
  restrictedItems      MenuItem[] @relation("CouponItems")

  @@index([isActive])
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

// One row per successful redemption — the audit trail a hard single-use
// flag on Coupon could never provide, and the source of truth for
// per-customer limit enforcement (findValidCoupon/consumeCoupon count a
// customer's rows here, scoped to one coupon, rather than trusting a
// boolean).
//
// Unlike the ledger models in this schema (StockMovement,
// GiftCardTransaction, LoyaltyTransaction), a row here IS deleted when
// its order is cancelled — see lib/cancel-order.ts. This is not a ledger
// of "what happened to a balance"; it answers "may this customer use
// this code", and a cancelled order shouldn't keep them locked out.
model CouponRedemption {
  id       String @id @default(cuid())
  coupon   Coupon @relation(fields: [couponId], references: [id])
  couponId String

  // One redemption per order, enforced by the @unique below — an order
  // can only ever have consumed one coupon (matches Order.couponCode
  // being a single nullable field, not a list).
  order   Order  @relation(fields: [orderId], references: [id])
  orderId String @unique

  // Identifies "who" redeemed this for per-customer-limit purposes: the
  // logged-in User.id when available, otherwise the normalized phone
  // number from billing (guest checkout is allowed — see Order.userId).
  // Not a foreign key on purpose, since a guest has no User row at all.
  //
  // KNOWN LIMITATION: a guest's phone number is self-asserted and never
  // verified, so changing one digit produces a "different customer" and
  // bypasses perCustomerLimit. Coupons that genuinely need a hard
  // per-person cap should require login.
  customerKey String

  // The actual discount amount granted on this specific order — kept here
  // (in addition to the denormalized Order.discountAmount) so redemption
  // history/analytics survive independently of the Order row's own
  // display fields, and so "how much did this coupon cost us in total"
  // is a simple SUM(discountAmount) over one coupon's redemptions.
  discountAmount Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  @@index([couponId, customerKey])
}

// ---------------------------------------------------------------------------
// Table reservations
//
// Design note: a table is NOT a static booked/free flag. Real restaurants
// reuse the same table across different time slots in a day, so "booked"
// only makes sense relative to a specific date/time window. Availability is
// computed at query time in the API layer by checking for overlapping
// Reservation rows for that table, not stored as a boolean on RestaurantTable.
// ---------------------------------------------------------------------------
model RestaurantTable {
  id        String   @id @default(cuid())
  label     String   @unique
  capacity  Int      @default(4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  reservations Reservation[]
  // QR Table Ordering — DINE_IN orders placed against this table (see
  // Order.tableId above). A table with isActive = false should have its QR
  // code treated as invalid by the ordering flow, not just hidden from the
  // reservation picker.
  orders Order[]
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// KNOWN GAPS (both worth closing before real bookings run through this):
//
// 1. No duration. reservedAt is a single instant, so "overlapping
//    reservations" isn't actually expressible in the data — the slot
//    length has to be a hardcoded constant in application code, which
//    means a 2-hour dinner and a 45-minute lunch can't coexist. Adding
//    `endsAt DateTime` fixes this.
//
// 2. No overlap constraint. Availability is checked at query time, so two
//    concurrent requests can both see a slot free and both insert. With
//    endsAt present, Postgres can enforce it properly via a raw-migration
//    exclusion constraint:
//      EXCLUDE USING gist (
//        "tableId" WITH =, tsrange("reservedAt", "endsAt") WITH &&
//      ) WHERE (status NOT IN ('CANCELLED','NO_SHOW'))
model Reservation {
  id           String            @id @default(cuid())
  customerName String
  phone        String
  guestCount   Int
  reservedAt   DateTime
  status       ReservationStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  table   RestaurantTable @relation(fields: [tableId], references: [id])
  tableId String

  // Optional: reservations don't require login (matches the current /table
  // page, which isn't behind auth), but we link the account when available.
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([tableId, reservedAt])
  // "My bookings" on the customer account page does `WHERE userId = ?`.
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Restaurant settings
//
// Single-row table pattern. NOTE: `@default("singleton")` sets the id but
// does not PREVENT a second row — a raw-migration
// `CHECK (id = 'singleton')` would actually enforce the invariant.
// ---------------------------------------------------------------------------
model RestaurantSettings {
  id               String   @id @default("singleton")
  timezone         String   @default("Asia/Dhaka")
  kitchenOpenHour  Int      @default(10)
  kitchenCloseHour Int      @default(22)
  updatedAt        DateTime @updatedAt

  // -------------------------------------------------------------------------
  // Money, tax, service charge and tipping
  //
  // Nothing below is hardcoded anywhere in the codebase, because none of it
  // is a fact about restaurants — it is a fact about the country the
  // restaurant happens to be in, and this system is meant to run in any of
  // them. The owner picks these once during setup; lib/pricing.ts is the
  // only consumer.
  //
  // The defaults describe a Bangladeshi non-AC restaurant (5% VAT added on
  // top of menu prices, no service charge, tipping off) purely because a
  // fresh install has to boot with SOMETHING. They carry no other meaning.
  // -------------------------------------------------------------------------

  // ISO 4217, e.g. "BDT", "USD", "EUR", "JPY", "KWD".
  currency String @default("BDT")

  // How many decimal places this currency subdivides into: 0 for JPY, KRW
  // and VND (there are no sen), 2 for most, 3 for KWD, BHD and OMR.
  //
  // This is NOT cosmetic. Stripe wants amounts in minor units, and the
  // multiplier is 10^currencyMinorUnits — so ¥1,200 must be sent as 1200,
  // not 120000. The old code multiplied by 100 unconditionally, which
  // silently overcharged every zero-decimal currency by 100×. See
  // toStripeMinorUnits in lib/money.ts.
  currencyMinorUnits Int @default(2)

  // --- Tax -----------------------------------------------------------------

  // Off for jurisdictions where a restaurant below the registration
  // threshold charges no tax at all. Setting this false zeroes the tax line
  // rather than hiding it, so invoices stay internally consistent.
  taxEnabled Boolean @default(true)

  // What it is called locally. Shown verbatim on the bill and copied onto
  // every Order at checkout: "VAT" (BD, EU, UK), "GST" (IN, AU, NZ, CA),
  // "Sales Tax" (US), "Consumption Tax" (JP), "IVA" (ES, IT).
  taxName String @default("VAT")

  // INCLUSIVE  — menu prices already contain the tax (EU, UK, JP, AU, IN).
  //              The bill total does not change; the tax line just declares
  //              how much of it was tax.
  // EXCLUSIVE  — tax is added on top at checkout (US, CA, BD).
  //
  // Getting this backwards does not produce a small rounding difference: it
  // over- or under-charges every single order by the full tax rate.
  taxMode TaxMode @default(EXCLUSIVE)

  // Rates as FRACTIONS (0.05000 = 5%), one per order type, because plenty
  // of countries genuinely tax the same food differently depending on how
  // it leaves the kitchen: Germany charges 19% dine-in but 7% takeaway, the
  // UK zero-rates cold takeaway food, and Bangladesh sets VAT by whether
  // the dining room is air-conditioned.
  taxRateDineIn   Decimal @default(0.05) @db.Decimal(8, 5)
  taxRateDelivery Decimal @default(0.05) @db.Decimal(8, 5)

  // --- Service charge ------------------------------------------------------

  // Fraction, applied to the subtotal AFTER discounts. Standard in India,
  // Southeast Asia and the Gulf; in the UK it is how restaurants collect
  // what Americans would tip. 0 disables the line entirely.
  serviceChargeRate Decimal @default(0) @db.Decimal(8, 5)

  // Whether the service charge is itself taxable. It is in most VAT
  // systems (it is consideration for a supply of services); it usually is
  // not under US sales tax when the charge is voluntary. Wrong either way
  // is a compliance problem, not a rounding one, so it is an explicit
  // switch rather than an assumption.
  serviceChargeTaxable Boolean @default(true)

  // --- Delivery ------------------------------------------------------------

  // Flat fee added to DELIVERY orders. A distance-based fee would need the
  // geocoding already present in lib/geocode.ts; deliberately out of scope
  // for v1 so the money model can land without also shipping a pricing
  // engine.
  deliveryFeeFlat    Decimal @default(0) @db.Decimal(12, 3)
  deliveryFeeTaxable Boolean @default(true)

  // --- Tipping -------------------------------------------------------------

  // Off by default, and it must stay possible to keep it off: in Japan,
  // South Korea and China offering a tip is not merely unusual but rude,
  // and a checkout that nags for one reads as broken rather than generous.
  tipEnabled Boolean @default(false)

  // Percentages offered as one-tap buttons at checkout, e.g. [10, 15, 20].
  // The customer can always enter a custom amount instead, and can always
  // decline. Percentages are of the discounted subtotal, NOT of the
  // tax-inclusive total — tipping on top of tax is a US convention, not a
  // universal one, and computing it from the subtotal is the interpretation
  // no one objects to.
  tipPresetPercents Int[] @default([10, 15, 20])
}

// How tax relates to the prices customers see on the menu. See
// RestaurantSettings.taxMode above, and applyTax() in lib/pricing.ts for
// the two formulas this selects between.
enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
}

// ---------------------------------------------------------------------------
// Reviews & Ratings
//
// Design note: verified-purchase eligibility (user must have a DELIVERED
// order containing this menuItem) is enforced in API logic, not as a schema
// constraint — same query-time-computation pattern used for
// RestaurantTable availability above, rather than denormalizing purchase
// state onto this model.
//
// One review per (user, menuItem) — @@unique below. Re-reviewing the same
// item after a repeat order is an UPDATE to the existing review, not a new
// row.
//
// avgRating/reviewCount are intentionally NOT cached on MenuItem; they are
// computed on read via aggregate query. Can be denormalized later purely as
// a perf optimization if needed — not a correctness requirement now.
//
// NOTE: userId is required, so guest orders — the majority of delivery
// orders, since checkout doesn't require login — can never leave a review.
// ---------------------------------------------------------------------------
model Review {
  id        String       @id @default(cuid())
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String

  @@unique([userId, menuItemId])
  @@index([menuItemId, status])
  // "My reviews" on the customer account page does `WHERE userId = ?`.
  // The [userId, menuItemId] unique above can serve this as a leftmost
  // prefix, but an explicit index keeps the intent obvious and survives
  // any future change to that constraint.
  @@index([userId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Loyalty / Rewards Points
//
// Ledger + cached balance pattern: every change to a user's points (an
// order getting DELIVERED, or an admin's manual adjustment) writes a
// LoyaltyTransaction row AND updates User.loyaltyPoints in the same DB
// transaction, so the running balance never drifts from its history.
//
// `points` is signed: positive = credit (earned), negative = debit
// (redeemed / manual deduction). `orderId` is optional because manual
// admin adjustments aren't tied to any specific order.
// ---------------------------------------------------------------------------
model LoyaltyTransaction {
  id        String        @id @default(cuid())
  points    Int
  reason    LoyaltyReason
  note      String?
  createdAt DateTime      @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?

  @@index([userId, createdAt])
  // Reverse lookup used by lib/cancel-order.ts: "was a credit already
  // awarded for this order, and how many points was it".
  @@index([orderId])
}

enum LoyaltyReason {
  ORDER_DELIVERED
  MANUAL_ADJUSTMENT
  // Customer spent points at checkout for a discount (see
  // lib/loyalty-redemption.ts). Recorded as a negative `points` value on
  // the transaction. A refund of redeemed points on cancellation reuses
  // MANUAL_ADJUSTMENT (positive), matching how a reversed ORDER_DELIVERED
  // credit already does — see reverseLoyaltyPoints in lib/cancel-order.ts.
  POINTS_REDEEMED
}

// ---------------------------------------------------------------------------
// Gift cards
//
// A gift card is purchased by one customer (or issued manually by an
// admin — comp/refund case) and redeemed, in full or in part, against a
// future order by whoever holds the code. Unlike a Coupon (a discount
// rule, reusable up to its limits), a GiftCard carries an actual dollar
// balance that is *spent down* over one or more redemptions until it hits
// zero — closer to a prepaid debit instrument than a discount code.
//
// balance is a denormalized running total, kept in sync with
// GiftCardTransaction rows inside the same DB transaction whenever it
// changes (a purchase credits it, an order redemption debits it) — same
// ledger + cached balance pattern as User.loyaltyPoints /
// LoyaltyTransaction. GiftCardTransaction is the authoritative,
// queryable audit log a bare balance column alone could never provide.
//
// isActive is an admin kill-switch (pull a card immediately, e.g. fraud
// or a support request), independent of balance reaching zero naturally
// through redemption.
//
// `balance` was Float (Postgres double precision) until the money-model
// migration, and it was a real problem for this model specifically,
// because a card is spent down incrementally: 50 - 19.99 - 12.35 - 17.66
// landed at ~1.8e-15 rather than 0, so the card read as "still has
// balance" forever. It is now Decimal(12,3), like every other money
// column in this schema — see lib/money.ts for why 3 decimal places and
// not 2.
// ---------------------------------------------------------------------------
model GiftCard {
  id   String @id @default(cuid())
  code String @unique

  // The balance still available to redeem. Starts at initialAmount and
  // only ever decreases (via REDEEM transactions) or increases (via a
  // manual admin ADJUSTMENT, e.g. a goodwill top-up, or a cancellation
  // refund written by lib/cancel-order.ts) — never reset.
  initialAmount Decimal @db.Decimal(12, 3)
  balance       Decimal @db.Decimal(12, 3)

  // Set once a Stripe Checkout Session for purchasing this card completes
  // (see checkout.session.completed handling in
  // src/app/api/webhooks/stripe/route.ts) — null for cards an admin
  // issues manually (comp/refund case), which are credited immediately
  // with no associated payment. The @unique is what makes the webhook
  // idempotent against Stripe's at-least-once delivery.
  stripeSessionId String? @unique

  // Who bought/received it — captured for the delivery email and admin
  // search, not used for redemption eligibility (anyone holding a valid,
  // active, non-zero-balance code may redeem it, matching how real gift
  // cards work — no login/ownership check at redemption time).
  purchaserEmail String?
  purchaserName  String?
  recipientEmail String?
  recipientName  String?
  message        String? // optional personal note included in the delivery email

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions GiftCardTransaction[]

  @@index([isActive])
}

enum GiftCardTransactionType {
  PURCHASE // initial credit when a customer buys the card via Stripe
  ISSUE // initial credit when an admin manually issues the card (no payment)
  REDEEM // debit when applied against an order — orderId is set
  ADJUSTMENT // manual admin balance correction, or a cancellation refund
}

// One row per balance-changing event — the audit trail a bare
// GiftCard.balance column alone could never provide, mirroring
// LoyaltyTransaction's ledger design. `amount` is signed: positive =
// credit (PURCHASE/ISSUE/a top-up ADJUSTMENT/a cancellation refund),
// negative = debit (REDEEM/a deduction ADJUSTMENT).
//
// Append-only: cancelling an order does NOT delete its REDEEM row, it
// writes a compensating positive ADJUSTMENT. The history of what
// happened stays intact.
model GiftCardTransaction {
  id     String                  @id @default(cuid())
  amount Decimal @db.Decimal(12, 3)
  type   GiftCardTransactionType
  note   String?

  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  giftCardId String

  // Set only for REDEEM (and the ADJUSTMENT that reverses one) — which
  // order this redemption paid down. Optional because
  // PURCHASE/ISSUE/manual ADJUSTMENT aren't tied to any order.
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?

  createdAt DateTime @default(now())

  @@index([giftCardId, createdAt])
  // Reverse lookup used by lib/cancel-order.ts: "has this order's
  // redemption already been refunded".
  @@index([orderId])
}

// ═══════════════════════════════════════════════════════════════════════
// INVENTORY MANAGEMENT — Phase 1 (core stock tracking + recipe deduction)
// ═══════════════════════════════════════════════════════════════════════
//
// Design mirrors the existing LoyaltyTransaction / GiftCardTransaction
// pattern already in this schema: a denormalized running balance on the
// "parent" (here, InventoryItem.currentStock) for fast reads, kept in
// sync with an append-only ledger (StockMovement) inside the same DB
// transaction whenever it changes. The ledger is the source of truth for
// "why did this number change" — currentStock alone can't answer that.
//
// Scope of this phase: track raw-ingredient stock, define what each menu
// item consumes (the recipe), and auto-deduct on order. Supplier /
// PurchaseOrder (the restocking side) is a deliberately separate Phase 2
// — this phase is usable on its own for stock visibility and low-stock
// alerts even before a purchasing workflow exists.

enum InventoryUnit {
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PIECE
}

model InventoryItem {
  id   String @id @default(cuid())
  name String @unique

  unit InventoryUnit

  // Denormalized running balance — see the file-level note above. Always
  // changed together with a StockMovement row in the same transaction,
  // never updated on its own.
  currentStock Float @default(0)

  // Below this level, the admin dashboard surfaces a low-stock warning
  // for this item. 0 (the default) means "no alert configured yet" —
  // deliberately not defaulted to something like 10, since a sensible
  // threshold depends entirely on the ingredient (10 units of salt vs 10
  // units of saffron mean very different things).
  reorderThreshold Float @default(0)

  // Latest known cost per unit — used to value currentStock and to
  // compute a menu item's food cost via its recipe. Updated whenever a
  // PurchaseOrder is received (Phase 2, most-recent-price-wins); can also
  // be set manually.
  costPerUnit Decimal @default(0) @db.Decimal(12, 3)

  // Soft-disable instead of deleting — an item with StockMovement/recipe
  // history shouldn't disappear from past records if discontinued.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usedInRecipes  MenuItemIngredient[]
  stockMovements StockMovement[]

  // Phase 2 — every PurchaseOrder line item that has ever ordered this
  // ingredient, across every supplier. Powers "who do we usually buy
  // this from, and at what price" on the item's detail view.
  purchaseOrderLines PurchaseOrderItem[]

  // Powers the "low stock" dashboard query: active items where
  // currentStock <= reorderThreshold. Filtering isActive first is the
  // selective predicate; the comparison itself can't be indexed directly
  // in Postgres (it's a column-to-column comparison, not a fixed value),
  // so this index gets the query to a small isActive=true set fast and
  // leaves a cheap in-memory filter for the threshold comparison itself.
  @@index([isActive])
}

// The recipe / Bill-of-Materials: how much of each InventoryItem one unit
// of a MenuItem consumes. E.g. one "Chicken Biryani" might consume 250g
// rice + 200g chicken + 15g mixed spices — three MenuItemIngredient rows.
model MenuItemIngredient {
  id String @id @default(cuid())

  // Quantity of InventoryItem.unit consumed per ONE unit of the menu
  // item sold. Multiplied by OrderItem.quantity at deduction time.
  quantityRequired Float

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String

  // A menu item shouldn't list the same raw ingredient twice — if the
  // amount changes, it's an update to the existing row, not a new one.
  @@unique([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
}

enum StockMovementType {
  // Stock received from a supplier — written automatically when a Phase 2
  // PurchaseOrder is received (see lib/receive-purchase-order.ts), or
  // recorded manually.
  PURCHASE
  // Automatic deduction on the PLACED -> PREPARING transition (see
  // lib/advance-order-to-preparing.ts). One row PER INGREDIENT, so a
  // three-ingredient dish produces three rows for the same orderId — the
  // "did this order already deduct" guard therefore lives on
  // Order.stockDeductedAt, not on a unique index here.
  ORDER_DEDUCTION
  // Spoilage, kitchen error, spillage — recorded manually by staff.
  WASTAGE
  // Manual correction after a physical stock count doesn't match
  // currentStock (the eventual reality of any perpetual-inventory system).
  ADJUSTMENT
  // Stock returned to inventory — written by lib/cancel-order.ts when an
  // order is cancelled AFTER deduction already happened, reversing each
  // ORDER_DEDUCTION row one-for-one.
  RETURN
}

model StockMovement {
  id   String            @id @default(cuid())
  type StockMovementType

  // Positive = stock added (PURCHASE, RETURN, upward ADJUSTMENT),
  // negative = stock removed (ORDER_DEDUCTION, WASTAGE, downward
  // ADJUSTMENT). Signed rather than split into separate in/out columns —
  // simpler to sum for any "net change over a period" report.
  quantityChange Float

  // Snapshot of InventoryItem.currentStock immediately AFTER this
  // movement was applied. Not strictly non-derivable (it's redundant with
  // summing prior movements), but storing it means an audit view never
  // needs to replay the whole ledger just to show "stock was X after this
  // event" — the same tradeoff GiftCardTransaction already makes by
  // storing balances alongside its ledger rows.
  resultingStock Float

  // Free-text context — e.g. "spilled during prep", "physical count
  // correction", supplier invoice number for a PURCHASE. Required in
  // practice at the application layer for WASTAGE/ADJUSTMENT (an
  // unexplained manual stock change is exactly what this table exists to
  // prevent), optional at the DB level for the same reason other
  // optional-in-practice fields in this schema are (ORDER_DEDUCTION
  // movements are self-explanatory via `order` below and don't need one).
  note String?

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String

  // Set only for ORDER_DEDUCTION (and the RETURN that reverses one) —
  // links back to the order that triggered it, so "why did chicken stock
  // drop by 2kg at 7:45pm" traces directly to an order. onDelete: SetNull
  // (not Cascade) so deleting an Order — which nothing in this app
  // actually does; orders are cancelled, not deleted — would never
  // silently erase inventory history either way.
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?

  // Staff member who recorded this movement. Null for automatic
  // ORDER_DEDUCTION/RETURN movements (the system did it, not a person)
  // and for PURCHASE rows created by an automated Phase-2 PurchaseOrder
  // receipt.
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())

  // The admin Inventory > [item] history view does
  // `WHERE inventoryItemId = ? ORDER BY createdAt DESC` — one item's full
  // movement history, newest first.
  @@index([inventoryItemId, createdAt])
  // Reverse lookup: "what did this order actually consume" — used when
  // reversing deductions on cancellation.
  @@index([orderId])
  // "What did this staff member record" — the manual-entry audit view.
  @@index([createdById])
}

// ═══════════════════════════════════════════════════════════════════════
// INVENTORY MANAGEMENT — Phase 2 (Supplier + Purchase Order restocking)
// ═══════════════════════════════════════════════════════════════════════
//
// Closes the loop Phase 1 left open: PURCHASE was already a valid
// StockMovementType, but nothing in the schema produced one — it had to
// be recorded by hand with no paper trail of which supplier, what was
// ordered vs. actually delivered, or at what cost. A PurchaseOrder is
// that paper trail; RECEIVING one is the only thing that actually moves
// stock (see the status/receiving note on PurchaseOrder below) — a
// PurchaseOrder sitting in DRAFT or ORDERED status has zero effect on
// InventoryItem.currentStock, same as a Coupon existing has zero effect
// on anyone's order until it's actually redeemed.
//
// Deliberately NOT modeling split/partial shipments (a PO arriving across
// several separate deliveries) — PurchaseOrderItem.quantityReceived can
// differ from quantityOrdered (a short delivery is common and needs to be
// recorded accurately), but receiving happens as ONE event per PO, not a
// running tally across multiple receiving sessions. Most small-to-mid
// restaurant purchasing is single-delivery; multi-delivery PO splitting
// is a real feature some larger operations need, but it's a meaningfully
// bigger workflow (a PurchaseOrder would need its own sub-ledger of
// receiving events) — left as a future Phase 3 rather than guessed at
// here.
// ---------------------------------------------------------------------------

model Supplier {
  id   String @id @default(cuid())
  name String

  phone   String?
  email   String?
  address String?

  // Soft-disable instead of deleting — a supplier with PurchaseOrder
  // history shouldn't disappear from past records if the restaurant
  // stops ordering from them. Same pattern as InventoryItem.isActive.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([isActive])
}

enum PurchaseOrderStatus {
  // Being assembled — line items can still be freely added/edited/removed.
  DRAFT
  // Sent to the supplier, awaiting delivery. Line items are locked at
  // this point (quantityOrdered/costPerUnit shouldn't silently change
  // after the supplier has already been told what was ordered).
  ORDERED
  // Delivery has arrived and been receivedAt — this is the ONLY status
  // transition that touches InventoryItem.currentStock (see the
  // receiving-logic note on PurchaseOrderItem below). Terminal state.
  RECEIVED
  // Called off before receiving — e.g. the supplier couldn't fulfill it.
  // Terminal state; never touches stock, regardless of which prior
  // status it was cancelled from.
  CANCELLED
}

model PurchaseOrder {
  id     String              @id @default(cuid())
  status PurchaseOrderStatus @default(DRAFT)

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  supplierId String

  // Denormalized sum of items[].quantityOrdered * items[].costPerUnit —
  // same "denormalized for display" tradeoff as Order.totalAmount,
  // avoids re-summing PurchaseOrderItem on every list-view row. Kept in
  // sync whenever line items are added/edited/removed (while status =
  // DRAFT) — not touched by the receiving step itself, since a short
  // delivery doesn't retroactively change what was ordered/agreed, only
  // what arrived.
  totalCost Decimal @default(0) @db.Decimal(12, 3)

  // Free-text — supplier invoice/reference number, delivery notes, why a
  // PO was cancelled, etc.
  note String?

  orderedAt  DateTime? // set when DRAFT -> ORDERED
  receivedAt DateTime? // set when ORDERED -> RECEIVED; drives the stock-crediting transaction

  // Staff member who created this PO. Nullable for the same reason as
  // StockMovement.createdBy — defensive against the user account being
  // removed later, not because a PO is ever created without a staff
  // member behind it.
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The admin Inventory > Purchase Orders list filters by supplier and by
  // status ("show me all ORDERED POs awaiting delivery, from Supplier X").
  @@index([supplierId, status])
  // The "Purchase Orders" tab's default view — open/pending POs across
  // all suppliers, so a plain status filter needs its own index (the
  // composite above can't serve a query with no supplierId predicate).
  @@index([status])
  // "POs raised by this staff member" — the purchasing audit view.
  @@index([createdById])
}

// One line item per InventoryItem on a PurchaseOrder — how much was
// ordered, at what agreed cost, and (once received) how much actually
// arrived.
model PurchaseOrderItem {
  id String @id @default(cuid())

  quantityOrdered Float

  // Defaults to 0 rather than mirroring quantityOrdered, so a PO that's
  // still ORDERED (not yet received) reads unambiguously as "nothing
  // received yet" rather than looking like a full delivery already
  // happened. Set to the actual delivered amount in the same transaction
  // that moves the parent PurchaseOrder to RECEIVED — see the schema-file
  // note above on why receiving is one event per PO, not an incremental
  // tally.
  quantityReceived Float @default(0)

  // Cost per InventoryItem.unit, locked in at order time — deliberately
  // NOT read from InventoryItem.costPerUnit at receiving time, since a
  // supplier's price on the day an order was placed is what this PO
  // actually cost regardless of what the catalog "current cost" drifts
  // to later. Receiving a PO writes ITS costPerUnit forward onto
  // InventoryItem.costPerUnit (most-recent-purchase-price wins) — see
  // the receiving-logic note below.
  costPerUnit Decimal @db.Decimal(12, 3)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId String

  // A PO shouldn't list the same ingredient twice — if the ordered
  // amount changes, it's an update to the existing line, not a new one.
  // Same reasoning as MenuItemIngredient's uniqueness constraint.
  @@unique([purchaseOrderId, inventoryItemId])
  @@index([inventoryItemId])
}
